  "render": {
    "width": 1080,
    "height": 1920,
    "fps": 60,
    "vcodec": "libx264",
    "acodec": "aac",
    "crf": 18,
    "preset": "medium",
    "pix_fmt": "yuv420p"
  },
  "speed_ramp": {
    "s_min": 1.0,
    "s_max": 30.0,
    "alpha": 0.0
  },
  "teaser": {
    "tail_fraction": 0.05,
    "duration_s": 2.5,
    "mask": "vignette"
  }
