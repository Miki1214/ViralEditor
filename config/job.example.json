{
  "video_path": "assets/timelapse.mp4",
  "audio_path": "assets/track.mp3",
  "output_path": "output/result.mp4",
  "seed": 42,
  "hook": {
    "text": "I built this in 30 days",
    "emphasis_words": ["30", "days"]
  },
  "style": {
